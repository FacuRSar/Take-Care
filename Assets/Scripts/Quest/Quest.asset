    SubtitlesForQuestHalf: 
    timer: 120
    Name: El Reflejo Mentiroso
    description: "La mu\xF1eca entra en un estado de furia ciega porque afirma que
      la camara vieja  se est\xE1 burlando de ella y mostr\xE1ndole \"otra cara\".
      Le ordena al jugador que lo tome inmediatamente y lo transporte hasta la chimenea
      encendida del sal\xF3n para destruirlo."
    id: 2
    TpDollID: Comedor
    itemsToPickData:
    - quantity: 1
      itemID: 1
    roomID: Chimenea
    EmotionID: 1
