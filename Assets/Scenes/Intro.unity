MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1679627210}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fbe9721d4f5434d9abcd8bcf1126587, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HintDialogueController
  subtitleUI: {fileID: 2024097066}
  gameStateController: {fileID: 1490577939}
  firstHintDelay: 20
  repeatInterval: 25
  hintPool:
  - text: Tendria que ver de donde viene esa canilla
    duration: 2
    requiredFlags:
    - doll_triggered
    blockedFlags:
    - faucet_closed
  - text: "Ese telefono... \xBFVa a durar por siempre?"
    duration: 2
    requiredFlags:
    - power_on
    blockedFlags:
    - phone_answered
  - text: Esto parece un juego que quiere que atienda el telefono
    duration: 2
    requiredFlags:
    - power_on
    blockedFlags:
    - phone_answered
  - text: Deberia ver como encender la luz
    duration: 2
    requiredFlags:
    - 
    blockedFlags:
    - power_on
  activeOnStart: 0
--- !u!114 &1679627213
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1679627210}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3337458350a6416f961e9f12bccfdaaa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  subtitleUI: {fileID: 2024097066}
  pools:
  - id: intro
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: Dios! No esperaba esta tormenta tan fuerte!
      delayBefore: 2
      duration: 2
    - text: Hola!?? Perdon por irrumpir!! La tormenta me sorprendio
      delayBefore: 2
      duration: 2
    - text: Bueno, parece abandonado... No veo que las luces esten funcionando
      delayBefore: 2
      duration: 2
  - id: energy_restored
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: Y se hizo la luz!! Alelluya!
      delayBefore: 2
      duration: 2
    - text: Este lugar es todavia mas feo con luz
      delayBefore: 2
      duration: 2
    - text: "Eso es... \xBFEl telefono?"
      delayBefore: 2
      duration: 2
  - id: phone_hello
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: "\xBFHola?"
      delayBefore: 2
      duration: 2
    - text: ...
      delayBefore: 2
      duration: 2
  - id: phone_surprise
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: QUE CARA..!!
      delayBefore: 0
      duration: 2
    - text: "Dios... Que susto, solo es una mu\xF1eca rota"
      delayBefore: 2
      duration: 2
  - id: doll_reaction
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: Un segundo...
      delayBefore: 2
      duration: 2
    - text: "Esta mu\xF1eca estaba aca antes?"
      delayBefore: 0
      duration: 2
  - id: bathroom_reaction
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: AHORA QUE!?
      delayBefore: 2
      duration: 2
    - text: "\xBFUna canilla? \xBFDe donde viene?"
      delayBefore: 2
      duration: 2
  - id: mirror_reaction
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: '!!!!'
      delayBefore: 2
      duration: 2
    - text: No no nono!!
      delayBefore: 0
      duration: 2
    - text: Me voy de aca!!
      delayBefore: 0
      duration: 2
  - id: captureMessege
    subtitleBackgroundColor: {r: 0.6698113, g: 0.16113384, b: 0.16113384, a: 0}
    lines:
    - text: Aun no es hora de irse querido... Aun no
      delayBefore: 2
      duration: 3
