--- !u!114 &1497450606
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1497450605}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3337458350a6416f961e9f12bccfdaaa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  subtitleUI: {fileID: 2024097066}
  pools:
  - id: "T\xE9_In"
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "\xA1Es una tarde hermosa para una fiesta! Pero mis invitadas fueron
        malas y rompieron las tazas... \xBFMe ayud\xE1s a encontrar tazas nuevas?
        No dejes que se enfr\xEDe el t\xE9"
      delayBefore: 0
      duration: 7.5
    - text: "\xA1Eso es! Uno por ac\xE1... Ten\xE9 cuidado, la porcelana muerde si
        la apret\xE1s mucho, jeje"
      delayBefore: 45
      duration: 4.5
    - text: "Faltan pocos. Mis amigas ya se est\xE1n sentando a la mesa. No las hagas
        esperar, no les gusta la mala educaci\xF3n"
      delayBefore: 90
      duration: 5.5
    - text: "\xA1Ya casi! Casi puedo oler el t\xE9... aunque hoy tiene un olor un
        poco met\xE1lico, \xBFverdad?"
      delayBefore: 135
      duration: 5
    - text: "\xA1El \xFAltimo fragmento! Ponelo en la mesa r\xE1pido, \xA1r\xE1pido!,
        \xA1que ya van a tomar el primer sorbo!"
      delayBefore: 162
      duration: 4.5
  - id: "T\xE9_Complete"
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "\xA1Perfecto! Mir\xE1 qu\xE9 lindos quedaron pegados. Ahora sentate
        con nosotras... prometemos no morder"
      delayBefore: 0
      duration: 5
  - id: "T\xE9_Fail"
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "Se enfri\xF3... Se enfri\xF3 por tu culpa. Sos un p\xE9simo anfitri\xF3n.
        Ahora mis amigas se van a tener que divertir... con vos"
      delayBefore: 0
      duration: 6.5
  - id: "\xBF?_In"
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "\xA1Me aburro! Vamos a jugar a las escondidas. Conta hasta tres"
      delayBefore: 0
      duration: 3
    - text: "ya me escond\xED... Si no me encontr\xE1s r\xE1pido, me voy a enojar.
        \xA1A buscarme!"
      delayBefore: 4
      duration: 3
    - text: "Fr\xEDo, fr\xEDo... Est\xE1s lej\xEDsimos. Mir\xE1s en los lugares equivocados.
        \xBFAcaso no quer\xE9s jugar conmigo?"
      delayBefore: 30
      duration: 5
    - text: "Te est\xE1s templando... puedo escuchar tus pasos torpes por la madera.
        Apurate que me da calor ac\xE1 adentro"
      delayBefore: 60
      duration: 5
    - text: "\xA1Te quem\xE1s! \xA1Estoy ac\xE1! Estir\xE1 la mano... \xA1recogeme!"
      delayBefore: 60
      duration: 4
  - id: "\xBF?_Complete"
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "Me encontraste! Qu\xE9 divertido. Sos muy bueno en esto. Ahora no me
        sueltes m\xE1s, \xBFdale?"
      delayBefore: 0
      duration: 5
  - id: "\xBF?_Fail"
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "Se termin\xF3 el tiempo... Perdiste. Qu\xE9 tramposo, no buscaste bien.\n"
      delayBefore: 0
      duration: 5
  - id: Mentiroso_In
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "Esa maldita camara me est\xE1 mirando mal! \xA1Dice que soy fea! \xA1Agarralo
        y llevalo a la chimenea ya mismo!"
      delayBefore: 0
      duration: 5
    - text: "\xA1No lo mires! \xA1Te va a mentir a vos tambi\xE9n! \xA1Camin\xE1
        m\xE1s r\xE1pido, carajo!"
      delayBefore: 30
      duration: 4
    - text: "\xA1No lo mires! \xA1Te va a mentir a vos tambi\xE9n! \xA1Camin\xE1
        m\xE1s r\xE1pido, carajo! \xA1Apurate antes de que le rompa la cara yo misma!"
      delayBefore: 60
      duration: 4
  - id: Mentiroso_Fail
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "\xA1Te tardaste! Se rompi\xF3... y sus pedazos me est\xE1n cortando
        por dentro... \xA1Es toda tu culpa!"
      delayBefore: 0
      duration: 5
  - id: Mentiroso_Complete
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "\xA1Eso! Mir\xE1 c\xF3mo se derrite... \xBFQui\xE9n se r\xEDe ahora,
        eh? Nadie se burla de m\xED en mi casa\n"
      delayBefore: 0
      duration: 5
  - id: Sonriente_In
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "\xA1Ten\xE9s que ver a mi hermosa familia! Eran tan buenos... pero se
        les cayeron las caritas del \xE1lbum. Busc\xE1 las dos fotos en el suelo,
        \xA1dale!"
      delayBefore: 0
      duration: 7
    - text: "\xA1Ya casi los tenemos a todos juntos otra vez! Me pregunto si se van
        a alegrar de verte..."
      delayBefore: 30
      duration: 7
    - text: "\xA1La \xFAltima! Agarrala r\xE1pido antes de que se borren sus sonrisas...
        \xA1R\xE1pido!"
      delayBefore: 50
      duration: 7
  - id: Sonriente_Complete
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: "\xA1Qu\xE9 lindos salimos todos! Ahora vos tambi\xE9n sos parte de la
        familia. Nos vamos a quedar ac\xE1 adentro para siempre!"
      delayBefore: 0
      duration: 5
  - id: Sonriente_Fail
    useCustomTextColor: 1
    subtitleTextColor: {r: 0.6784314, g: 0.5411765, b: 0.6627451, a: 1}
    lines:
    - text: 'Se rompieron... Ya no tienen cara. Sos muy torpe... ahora voy a tener
        que buscarme una familia nueva

'
      delayBefore: 0
      duration: 5
