--- !u!114 &7104920909096477618
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2704489524996890803}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3337458350a6416f961e9f12bccfdaaa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  subtitleUI: {fileID: 0}
  pools:
  - id: intro
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: Dios! No esperaba esta tormenta tan fuerte!
      delayBefore: 2
      duration: 2
    - text: Hola!?? Perdon por irrumpir!! La tormenta me sorprendio
      delayBefore: 2
      duration: 2
    - text: Bueno, parece abandonado... No veo que las luces esten funcionando
      delayBefore: 2
      duration: 2
  - id: energy_restored
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: Y se hizo la luz!! Alelluya!
      delayBefore: 2
      duration: 2
    - text: Este lugar es todavia mas feo con luz
      delayBefore: 2
      duration: 2
    - text: "Eso es... \xBFEl telefono?"
      delayBefore: 2
      duration: 2
  - id: phone_hello
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: "\xBFHola?"
      delayBefore: 2
      duration: 2
    - text: ...
      delayBefore: 2
      duration: 2
  - id: phone_surprise
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: QUE CARA..!!
      delayBefore: 0
      duration: 2
    - text: "Dios... Que susto, solo es una mu\xF1eca rota"
      delayBefore: 2
      duration: 2
  - id: doll_reaction
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: Un segundo...
      delayBefore: 2
      duration: 2
    - text: "Esta mu\xF1eca estaba aca antes?"
      delayBefore: 0
      duration: 2
  - id: bathroom_reaction
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: AHORA QUE!?
      delayBefore: 2
      duration: 2
    - text: "\xBFUna canilla? \xBFDe donde viene?"
      delayBefore: 2
      duration: 2
  - id: mirror_reaction
    subtitleBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
    lines:
    - text: '!!!!'
      delayBefore: 2
      duration: 2
    - text: No no nono!!
      delayBefore: 0
      duration: 2
    - text: Me voy de aca!!
      delayBefore: 0
      duration: 2
  - id: captureMessege
    subtitleBackgroundColor: {r: 0.5754717, g: 0.16015486, b: 0.16015486, a: 0}
    lines:
    - text: Todavia no es hora de irse querido
      delayBefore: 2
      duration: 2
